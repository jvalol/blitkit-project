#!/usr/bin/env bash
# Tests and lints the engine and every game built on it, in that order.
#
# The games depend on dynamo_lib by relative path, so an engine change can break
# them without anyone noticing until the game is run. This is the one command
# that says whether the whole project still holds together.

set -uo pipefail
cd "$(dirname "$0")" || exit 1

repos=(blitkit pong snake tetris marble)
failed=()

for repo in "${repos[@]}"; do
  echo "== $repo"
  if ! (cd "$repo" && cargo test --quiet && cargo clippy --quiet --all-targets -- -D warnings); then
    failed+=("$repo")
  fi
done

echo
if [ ${#failed[@]} -eq 0 ]; then
  echo "all ${#repos[@]} pass"
else
  echo "failed: ${failed[*]}"
  exit 1
fi
